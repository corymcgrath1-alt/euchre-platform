# Safe public values bundled into the mobile client. These defaults are also centralized
# in mobile.release.json; override them only when moving to another owned HTTPS host.
VITE_PRIVACY_POLICY_URL=https://corymcgrath1-alt.github.io/euchre-platform/privacy/
VITE_SUPPORT_URL=https://corymcgrath1-alt.github.io/euchre-platform/support/
VITE_SUPPORT_REQUEST_URL=https://github.com/corymcgrath1-alt/euchre-platform/issues/new?template=euchre-support.yml

# Apple signing is intentionally absent. Never prefix signing credentials with VITE_.
# APPLE_TEAM_ID=OWNER_SUPPLIED_ON_MAC
# IOS_SIGNING_IDENTITY=OWNER_SUPPLIED_ON_MAC
# IOS_PROVISIONING_PROFILE_SPECIFIER=OWNER_SUPPLIED_ON_MAC
